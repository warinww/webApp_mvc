@{
    ViewData["Title"] = "Home Page";
}

@model List<User>

@{
    ViewData["Title"] = "User List";
}

<h2>User List</h2>

@foreach (var user in Model)
{
    <hr />
    <div class="user-card">
        <p>Name: @user.Username</p>
        <p>Age: @user.Age</p>
        <a href="@Url.Action("Profile", "User", new { id = user._id })">View Profile</a>
    </div>
}

